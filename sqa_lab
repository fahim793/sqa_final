package com.lab.tests;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import java.time.Duration;

public class LabFinal_Test {
    public static void main(String[] args) {

        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();

       
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));

        try {
            
            driver.get("https://opensource-demo.orangehrmlive.com/");

            
            WebElement usernameInput = wait.until(ExpectedConditions.visibilityOfElementLocated(By.name("username")));
            usernameInput.sendKeys("Admin");

           
            WebElement passwordInput = driver.findElement(By.name("password"));
            passwordInput.sendKeys("admin123");

         
            WebElement loginButton = driver.findElement(By.cssSelector("button[type='submit']"));
            loginButton.click();

            WebElement dashboardHeader = wait.until(ExpectedConditions.visibilityOfElementLocated(
                    By.xpath("//h6[text()='Dashboard']")
            ));
            if (dashboardHeader.isDisplayed()) {
                System.out.println("Verification Passed: Dashboard is displayed successfully.");
            } else {
                System.out.println("Verification Failed: Dashboard is not displayed.");
            }

           
            WebElement userProfileMenu = wait.until(ExpectedConditions.elementToBeClickable(
                    By.cssSelector(".oxd-userdropdown-tab")
            ));
            userProfileMenu.click();

           
            WebElement logoutLink = wait.until(ExpectedConditions.elementToBeClickable(
                    By.xpath("//a[text()='Logout']")
            ));
            logoutLink.click();

          
            WebElement loginHeader = wait.until(ExpectedConditions.visibilityOfElementLocated(
                    By.xpath("//h5[text()='Login']")
            ));
            if (loginHeader.isDisplayed() && driver.getCurrentUrl().contains("auth/login")) {
                System.out.println("Verification Passed: Logged out successfully and Login page is displayed.");
            } else {
                System.out.println("Verification Failed: Login page is not displayed.");
            }

        } catch (Exception e) {
            e.printStackTrace();
        } finally {
          
           
        }
    }
}
